{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skin-routine-copilot.local/schemas/synthetic-corpus.v1.schema.json",
  "title": "Locked synthetic Ingredient Intelligence corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_kind", "corpus_version", "build_eligible", "documents"],
  "properties": {
    "schema_version": { "const": 1 },
    "fixture_kind": { "const": "synthetic_only" },
    "corpus_version": { "type": "string", "pattern": "^synthetic-v[0-9]+$" },
    "build_eligible": { "const": false },
    "documents": {
      "type": "array",
      "minItems": 5,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/document" }
    }
  },
  "$defs": {
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunk_id", "source_id", "document_id", "question_class", "section_path", "ordinal", "text", "start_char", "end_char", "content_hash", "build_eligible"],
      "properties": {
        "chunk_id": { "type": "string", "pattern": "^chk_syn_src_q[1-5]_" },
        "source_id": { "type": "string", "pattern": "^syn_src_q[1-5]_[a-f0-9]{8}$" },
        "document_id": { "type": "string", "pattern": "^doc_syn_src_q[1-5]_" },
        "question_class": { "enum": ["Q1", "Q2", "Q3", "Q4", "Q5"] },
        "section_path": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
        "ordinal": { "type": "integer", "minimum": 0 },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "start_char": { "type": "integer", "minimum": 0 },
        "end_char": { "type": "integer", "minimum": 1 },
        "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "build_eligible": { "const": false }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "publisher", "canonical_url", "question_class", "title", "normalized_text", "document_id", "document_hash", "retrieved_at", "build_eligible", "chunks"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^syn_src_q[1-5]_[a-f0-9]{8}$" },
        "publisher": { "const": "Synthetic Test Publisher" },
        "canonical_url": { "type": "string", "pattern": "^https://[a-z0-9-]+\\.fixture\\.invalid/" },
        "question_class": { "enum": ["Q1", "Q2", "Q3", "Q4", "Q5"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 180 },
        "normalized_text": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "document_id": { "type": "string", "pattern": "^doc_syn_src_q[1-5]_" },
        "document_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "build_eligible": { "const": false },
        "chunks": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/chunk" } }
      }
    }
  }
}
