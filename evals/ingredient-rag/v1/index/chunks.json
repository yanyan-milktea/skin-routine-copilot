    "section_path": [
      "Synthetic guide to retinoids and retinol",
      "Sun protection while using retinoids"
    ],
    "ordinal": 0,
    "text": "The synthetic guide also recommends daily sunscreen while using retinoids, because it reports that skin may be more sensitive to the sun during use.",
    "start_char": 918,
    "end_char": 1066,
