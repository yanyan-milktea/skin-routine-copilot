    "section_path": [
      "Synthetic note on cosmetic ingredient regulation",
      "Premarket approval"
    ],
    "ordinal": 0,
    "text": "In this synthetic note, the fictional regulator does not require premarket approval for cosmetic products or their ingredients before they are sold. Except for color additives, the note says the fictional regulator does not pre-clear ordinary cosmetic ingredients.",
    "start_char": 75,
    "end_char": 339,
    "content_hash": "sha256:8fa3711943db8394bd9c2b1f5c8177cb0d2b0313d460292a9e83d2807dfda033",
    "token_estimate": 51,
    "overlaps_previous": false,
