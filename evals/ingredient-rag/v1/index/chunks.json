    "section_path": [
      "Synthetic guide to skin care during pregnancy",
      "General scope"
    ],
    "ordinal": 0,
    "text": "This synthetic guide offers general educational information about skin care routines during pregnancy and breastfeeding. It notes that many people change their routine during pregnancy and that individual needs differ.",
    "start_char": 67,
    "end_char": 285,
